# CollegeNav — Environment Configuration
# Copy this file to .env.local or .env to configure Firebase Realtime Database
# Note: Keep service-account private keys and credentials OUT of frontend code.

# Firebase Web App Config (Vite client-accessible via import.meta.env)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Fallback & Offline Mode Behavior
# Set to 'true' to force offline fallback mode using verified local dataset
VITE_FORCE_OFFLINE_FALLBACK="false"
